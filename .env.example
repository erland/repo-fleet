# RepoFleet Docker Compose/local runtime configuration
# Copy this file to .env and adjust values as needed.
# Do not commit real secrets.

# Compose/runtime naming and host ports.
COMPOSE_PROJECT_NAME=repo-fleet
REPOFLEET_FRONTEND_PORT=8080
REPOFLEET_BACKEND_PORT=8081

# Optional image names. Compose builds these images when starting with --build.
REPOFLEET_FRONTEND_IMAGE=repo-fleet-frontend:local
REPOFLEET_BACKEND_IMAGE=repo-fleet-backend:local

# RepoFleet GitHub App configuration.
# Phase 1 can start without these values; the GitHub connection will report NOT_CONFIGURED.
REPOFLEET_GITHUB_APP_ID=
REPOFLEET_GITHUB_INSTALLATION_ID=

# Prefer a mounted/readable path in managed deployments. For the simple Compose
# runtime, PEM text can be supplied through REPOFLEET_GITHUB_PRIVATE_KEY.
REPOFLEET_GITHUB_PRIVATE_KEY_PATH=
REPOFLEET_GITHUB_PRIVATE_KEY=

# Installation tokens are refreshed this many seconds before GitHub expiry.
REPOFLEET_GITHUB_TOKEN_REFRESH_MARGIN_SECONDS=300

# Optional GitHub Enterprise/API override.
GITHUB_API_URL=https://api.github.com

# Optional JVM tuning for the backend container.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
