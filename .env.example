# RepoFleet GitHub App configuration
# Do not commit real secrets. The private key file itself is ignored by .gitignore.
REPOFLEET_GITHUB_APP_ID=
REPOFLEET_GITHUB_INSTALLATION_ID=
REPOFLEET_GITHUB_PRIVATE_KEY_PATH=
# Alternative to *_PRIVATE_KEY_PATH. PEM can use literal newlines or escaped \n.
# REPOFLEET_GITHUB_PRIVATE_KEY=
# Optional; installation tokens are refreshed this many seconds before GitHub expiry.
REPOFLEET_GITHUB_TOKEN_REFRESH_MARGIN_SECONDS=300
# Optional GitHub Enterprise/API override.
# GITHUB_API_URL=https://api.github.com
