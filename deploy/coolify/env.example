# Release images
REPOFLEET_VERSION=latest
REPOFLEET_BACKEND_IMAGE=ghcr.io/erland/repo-fleet-backend
REPOFLEET_FRONTEND_IMAGE=ghcr.io/erland/repo-fleet-frontend

# Shared PostgreSQL resource
REPOFLEET_DB_HOST=replace-with-coolify-postgres-host
REPOFLEET_DB_NAME=repofleet
REPOFLEET_DB_USER=repofleet
REPOFLEET_DB_PASSWORD=replace-with-long-random-password

# GitHub App repository access
REPOFLEET_GITHUB_APP_ID=replace-me
REPOFLEET_GITHUB_INSTALLATION_ID=replace-me
# PKCS#8 PEM may be supplied on one line with literal \n sequences.
REPOFLEET_GITHUB_PRIVATE_KEY=replace-me
REPOFLEET_GITHUB_WEBHOOK_SECRET=replace-with-long-random-secret

# GitHub user authentication
REPOFLEET_AUTH_ENABLED=true
REPOFLEET_AUTH_CLIENT_ID=replace-me
REPOFLEET_AUTH_CLIENT_SECRET=replace-me
REPOFLEET_AUTH_SESSION_SECRET=replace-with-long-random-secret
REPOFLEET_AUTH_ALLOWED_USERS=replace-me
REPOFLEET_AUTH_CALLBACK_URL=https://repo-fleet.apps.isaksson.info/api/auth/github/callback
REPOFLEET_AUTH_SESSION_HOURS=12
REPOFLEET_AUTH_COOKIE_SECURE=true

# Optional
REPOFLEET_GITHUB_TOKEN_REFRESH_MARGIN_SECONDS=300
GITHUB_API_URL=https://api.github.com
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
